# Source unique de configuration, lue par le Makefile.
# Syntaxe Makefile : CLE=valeur, sans guillemets, sans espace autour du "=".
# Surcharges perso non versionnées : config/robotkraft.env.local (même syntaxe).
# Surcharge ponctuelle : make record NUM_EPISODES=10

# --- Bras SO-101 : symlinks stables créés par `make udev` ---
FOLLOWER_PORT=/dev/so101_follower
LEADER_PORT=/dev/so101_leader
# Les ids donnent leur nom aux fichiers de calibration : ne plus les changer après calibration.
# Mêmes ids que le repo du challenge, pour réutiliser ses calibrations (make import-calib).
FOLLOWER_ID=follower_arm
LEADER_ID=leader_arm

# --- Caméras : 640x480 @ 30 fps pour les deux, profondeur désactivée ---
CAM_WIDTH=640
CAM_HEIGHT=480
CAM_FPS=30
# camera1 = vue fixe : flux RGB de l'OAK-D Lite, publié en ZMQ par scripts/oak_zmq_server.py
CAM1_ZMQ_PORT=5555
CAM1_ZMQ_NAME=top
# camera2 = poignet : chemin stable /dev/v4l/by-id/...-video-index0 (voir `make cameras`)
WRIST_CAM=/dev/v4l/by-id/usb-Innomaker_Innomaker-U20CAM-1080p-S1_SN0001-video-index0

# --- Tâche et dataset : une seule tâche, une seule phrase, identique au record et au rollout ---
HF_USER=CHANGE_ME
TASK_NAME=pickplace
TASK_TEXT=Pick up the cube and place it in the box.
DATASET_REPO_ID=$(HF_USER)/robotkraft_$(TASK_NAME)
NUM_EPISODES=50
EPISODE_TIME_S=20
RESET_TIME_S=10
PUSH_TO_HUB=false
HUB_PRIVATE=true

# --- Entraînement SmolVLA ---
POLICY_BASE=lerobot/smolvla_base
TRAIN_STEPS=20000
BATCH_SIZE=32
SAVE_FREQ=5000
TRAIN_OUTPUT_DIR=outputs/train/smolvla_$(TASK_NAME)
PUSH_MODEL=false
MODEL_REPO_ID=$(HF_USER)/smolvla_robotkraft_$(TASK_NAME)
# ACT, policy de secours sur le même dataset : inférence fluide sur le CPU du PC
# (mesuré : 0,3 s par paquet de 100 actions, contre 5 s par paquet de 50 pour SmolVLA).
ACT_STEPS=100000
ACT_BATCH_SIZE=8
ACT_SAVE_FREQ=10000
ACT_OUTPUT_DIR=outputs/train/act_$(TASK_NAME)
ACT_MODEL_REPO_ID=$(HF_USER)/act_robotkraft_$(TASK_NAME)
# HF Jobs (payant, facturé à la seconde) : uniquement avec make train-hf-job CONFIRM_PAID=yes
HF_JOB_FLAVOR=a10g-small
HF_JOB_TIMEOUT=8h

# --- Rollout et évaluation ---
POLICY_PATH=$(TRAIN_OUTPUT_DIR)/checkpoints/last/pretrained_model
POLICY_DEVICE=cpu
EVAL_EPISODES=10
# Sur CPU avec SmolVLA, le bras avance par à-coups : prévoir EVAL_EPISODE_TIME_S=90.
EVAL_EPISODE_TIME_S=30
EVAL_RESET_TIME_S=15
# Inférence asynchrone (policy sur une machine GPU du réseau) : make rollout-async
ASYNC_SERVER=
ASYNC_POLICY=$(MODEL_REPO_ID)

# --- Exécution ---
# docker : image du challenge + couche smolvla (make install). native : lerobot installé dans l'env actif.
RUNNER=docker
BASE_IMAGE=ghcr.io/alsacedigitale/robotkraft:latest
IMAGE=robotkraft-smolvla:local
# Cache Hugging Face monté dans le conteneur : calibrations, datasets, modèles, token.
CACHE_DIR=.cache
